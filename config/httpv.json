{
  "schema_version": 1,
  "upstreams": [
    {
      "id": "local-app",
      "name": "Local application",
      "url": "http://host.docker.internal:9998",
      "host_header": "127.0.0.1:9998",
      "targets": [
        {"id": "local-app-1", "url": "http://host.docker.internal:9998", "host_header": "127.0.0.1:9998", "weight": 1}
      ],
      "max_failures": 1,
      "failure_timeout_ms": 10000
    }
  ],
  "routes": [
    {
      "id": "default-route",
      "name": "Default route",
      "enabled": true,
      "match": {
        "host": "",
        "path_prefix": "/",
        "method": ""
      },
      "upstream_id": "local-app"
    }
  ],
  "subjects": [
    {
      "id": "default",
      "name": "Default traffic",
      "enabled": true,
      "display": true,
      "match": {
        "host": "",
        "path_prefix": "/",
        "method": ""
      },
      "gate": {
        "enabled": false,
        "timeout_ms": 30000,
        "timeout_action": "block",
        "max_pending": 2000,
        "overflow_action": "block",
        "failure_action": "allow"
      },
      "capture": {
        "enabled": false,
        "request_headers": true,
        "response_headers": true,
        "request_body": false,
        "response_body": false,
        "max_body_bytes": 16384,
        "ttl_seconds": 60,
        "sample_rate": 1,
        "content_types": ["application/json", "application/x-www-form-urlencoded", "application/xml", "text/"],
        "redact_headers": ["authorization", "cookie", "set-cookie", "proxy-authorization", "x-api-key"]
      }
    }
  ],
  "rules": []
}
