{
  "name": "httpv-e2e",
  "services": {
    "control": {
      "build": "./control",
      "environment": {
        "HTTPV_VISUAL_DETAIL_STARTS_PER_SEC": "32",
        "HTTPV_DEMO_MAX_CONCURRENCY": "128",
        "HTTPV_OPENRESTY_ADMIN_URL": "http://openresty:8091",
        "HTTPV_GATEWAY_URL": "http://openresty:8088",
        "HTTPV_NATIVE_POLICY_PATH": "/run/httpv/policy.bin",
        "HTTPV_CONTROL_STATE_PATH": "/run/httpv/control-state.json",
        "HTTPV_AUDIT_LOG_PATH": "/run/httpv/audit.jsonl",
        "HTTPV_ADMIN_TOKEN": "httpv-e2e-admin",
        "HTTPV_OPERATOR_TOKEN": "httpv-e2e-operator",
        "HTTPV_VIEWER_TOKEN": "httpv-e2e-viewer",
        "HTTPV_DEFAULT_UPSTREAM_URL": "http://demo:9000",
        "HTTPV_DEFAULT_UPSTREAM_HOST": "demo:9000"
      },
      "ports": ["18090:8090"],
      "volumes": ["httpv_runtime:/run/httpv"],
      "networks": ["internal"]
    },
    "openresty": {
      "build": {"context": ".", "dockerfile": "openresty/Dockerfile"},
      "environment": {
        "HTTPV_UPSTREAM_URL": "http://demo:9000",
        "HTTPV_UPSTREAM_HOST": "demo:9000",
        "HTTPV_PROXY_CONNECT_TIMEOUT": "2s",
        "HTTPV_PROXY_READ_TIMEOUT": "30s",
        "HTTPV_PROXY_SEND_TIMEOUT": "30s",
        "HTTPV_MAX_BODY_SIZE": "64m",
        "HTTPV_ACCESS_LOG": "off"
      },
      "ports": ["18088:8088", "127.0.0.1:18091:8091"],
      "volumes": ["httpv_runtime:/run/httpv"],
      "depends_on": ["control", "demo", "edge-agent"],
      "networks": ["internal"]
    },
    "demo": {
      "build": "./demo",
      "environment": {"HTTPV_DEMO_ID": "primary"},
      "networks": ["internal"]
    },
    "demo2": {
      "build": "./demo",
      "environment": {"HTTPV_DEMO_ID": "secondary"},
      "networks": ["internal"]
    },
    "edge-agent": {
      "build": "./edge-agent",
      "environment": {
        "HTTPV_AGENT_SOCKET_PATH": "/run/httpv/edge-agent.sock",
        "HTTPV_AGENT_NATIVE_SOCKET_PATH": "/run/httpv/native.sock",
        "HTTPV_AGENT_RING_DIRECTORY": "/run/httpv",
        "HTTPV_AGENT_NATIVE_SOCKET_BUFFER_BYTES": "8388608",
        "HTTPV_AGENT_CONTROL_ADDR": "control:9100",
        "HTTPV_AGENT_CONTROL_DNS_REFRESH_MS": "1000",
        "HTTPV_AGENT_METRICS_ADDR": "0.0.0.0:9102",
        "HTTPV_AGENT_QUEUE_CAPACITY": "65536",
        "HTTPV_AGENT_FORWARD_WORKERS": "4"
      },
      "volumes": ["httpv_runtime:/run/httpv"],
      "depends_on": ["control"],
      "ports": ["127.0.0.1:19102:9102"],
      "networks": ["internal"]
    },
    "web": {
      "build": "./web",
      "ports": ["15173:80"],
      "depends_on": ["control"],
      "networks": ["internal"]
    }
  },
  "networks": {
    "internal": {"driver": "bridge"}
  },
  "volumes": {
    "httpv_runtime": {}
  }
}
