{
  "name": "httpv",
  "services": {
    "control": {
      "build": "./control",
      "environment": {
        "HTTPV_VISUAL_DETAIL_STARTS_PER_SEC": "360",
        "HTTPV_OPENRESTY_ADMIN_URL": "http://openresty:8091",
        "HTTPV_GATEWAY_URL": "http://openresty:8088",
        "HTTPV_NATIVE_POLICY_PATH": "/run/httpv/policy.bin",
        "HTTPV_CONTROL_STATE_PATH": "/run/httpv/control-state.json",
        "HTTPV_AUDIT_LOG_PATH": "/run/httpv/audit.jsonl",
        "HTTPV_CONFIG_PATH": "/etc/httpv/httpv.json",
        "HTTPV_DEFAULT_UPSTREAM_URL": "http://host.docker.internal:9998",
        "HTTPV_DEFAULT_UPSTREAM_HOST": "127.0.0.1:9998"
      },
      "ports": ["8090:8090"],
      "volumes": ["httpv_runtime:/run/httpv", "./config/httpv.json:/etc/httpv/httpv.json:ro"],
      "networks": ["internal"]
    },
    "openresty": {
      "build": {"context": ".", "dockerfile": "openresty/Dockerfile"},
      "environment": {
        "HTTPV_UPSTREAM_URL": "http://host.docker.internal:9998",
        "HTTPV_UPSTREAM_HOST": "127.0.0.1:9998",
        "HTTPV_PROXY_CONNECT_TIMEOUT": "5s",
        "HTTPV_PROXY_READ_TIMEOUT": "60s",
        "HTTPV_PROXY_SEND_TIMEOUT": "60s",
        "HTTPV_MAX_BODY_SIZE": "64m",
        "HTTPV_ACCESS_LOG": "off"
      },
      "ports": ["8088:8088", "127.0.0.1:8091:8091"],
      "extra_hosts": ["host.docker.internal:host-gateway"],
      "volumes": ["httpv_runtime:/run/httpv"],
      "depends_on": ["control", "edge-agent"],
      "networks": ["internal"]
    },
    "demo": {
      "build": "./demo",
      "networks": ["internal"]
    },
    "edge-agent": {
      "build": "./edge-agent",
      "environment": {
        "HTTPV_AGENT_SOCKET_PATH": "/run/httpv/edge-agent.sock",
        "HTTPV_AGENT_NATIVE_SOCKET_PATH": "/run/httpv/native.sock",
        "HTTPV_AGENT_RING_DIRECTORY": "/run/httpv",
        "HTTPV_AGENT_NATIVE_SOCKET_BUFFER_BYTES": "8388608",
        "HTTPV_AGENT_CONTROL_ADDR": "control:9100",
        "HTTPV_AGENT_CONTROL_DNS_REFRESH_MS": "1000",
        "HTTPV_AGENT_METRICS_ADDR": "0.0.0.0:9102",
        "HTTPV_AGENT_QUEUE_CAPACITY": "65536",
        "HTTPV_AGENT_FORWARD_WORKERS": "4"
      },
      "volumes": ["httpv_runtime:/run/httpv"],
      "depends_on": ["control"],
      "ports": ["127.0.0.1:9102:9102"],
      "networks": ["internal"]
    },
    "web": {
      "build": "./web",
      "ports": ["5173:80"],
      "depends_on": ["control"],
      "networks": ["internal"]
    }
  },
  "networks": {
    "internal": {"driver": "bridge"}
  },
  "volumes": {
    "httpv_runtime": {}
  }
}
