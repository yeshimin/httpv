{
  "name": "httpv",
  "services": {
    "control": {
      "image": "ghcr.io/yeshimin/httpv-control:${HTTPV_VERSION:-latest}",
      "restart": "unless-stopped",
      "environment": {
        "HTTPV_VISUAL_DETAIL_STARTS_PER_SEC": "${HTTPV_VISUAL_DETAIL_STARTS_PER_SEC:-360}",
        "HTTPV_OPENRESTY_ADMIN_URL": "http://openresty:8091",
        "HTTPV_GATEWAY_URL": "http://openresty:8088",
        "HTTPV_NATIVE_POLICY_PATH": "/run/httpv/policy.bin",
        "HTTPV_CONTROL_STATE_PATH": "/run/httpv/control-state.json",
        "HTTPV_AUDIT_LOG_PATH": "/run/httpv/audit.jsonl",
        "HTTPV_CONFIG_PATH": "/etc/httpv/httpv.json",
        "HTTPV_ADMIN_TOKEN": "${HTTPV_ADMIN_TOKEN:?set HTTPV_ADMIN_TOKEN}",
        "HTTPV_OPERATOR_TOKEN": "${HTTPV_OPERATOR_TOKEN:-}",
        "HTTPV_VIEWER_TOKEN": "${HTTPV_VIEWER_TOKEN:-}",
        "HTTPV_DEFAULT_UPSTREAM_URL": "${HTTPV_UPSTREAM_URL:-http://host.docker.internal:9998}",
        "HTTPV_DEFAULT_UPSTREAM_HOST": "${HTTPV_UPSTREAM_HOST:-127.0.0.1:9998}"
      },
      "volumes": [
        "httpv_runtime:/run/httpv",
        "${HTTPV_CONFIG_FILE:-./httpv.json}:/etc/httpv/httpv.json:ro"
      ],
      "healthcheck": {
        "test": ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8090/healthz"],
        "interval": "10s",
        "timeout": "3s",
        "retries": 5
      },
      "security_opt": ["no-new-privileges:true"],
      "networks": ["internal"]
    },
    "edge-agent": {
      "image": "ghcr.io/yeshimin/httpv-edge-agent:${HTTPV_VERSION:-latest}",
      "restart": "unless-stopped",
      "environment": {
        "HTTPV_AGENT_SOCKET_PATH": "/run/httpv/edge-agent.sock",
        "HTTPV_AGENT_NATIVE_SOCKET_PATH": "/run/httpv/native.sock",
        "HTTPV_AGENT_RING_DIRECTORY": "/run/httpv",
        "HTTPV_AGENT_NATIVE_SOCKET_BUFFER_BYTES": "8388608",
        "HTTPV_AGENT_CONTROL_ADDR": "control:9100",
        "HTTPV_AGENT_CONTROL_DNS_REFRESH_MS": "${HTTPV_AGENT_CONTROL_DNS_REFRESH_MS:-1000}",
        "HTTPV_AGENT_METRICS_ADDR": "0.0.0.0:9102",
        "HTTPV_AGENT_QUEUE_CAPACITY": "65536",
        "HTTPV_AGENT_FORWARD_WORKERS": "4"
      },
      "volumes": ["httpv_runtime:/run/httpv"],
      "depends_on": {"control": {"condition": "service_healthy"}},
      "ports": ["127.0.0.1:${HTTPV_EDGE_METRICS_PORT:-9102}:9102"],
      "security_opt": ["no-new-privileges:true"],
      "networks": ["internal"]
    },
    "openresty": {
      "image": "ghcr.io/yeshimin/httpv-openresty:${HTTPV_VERSION:-latest}",
      "restart": "unless-stopped",
      "environment": {
        "HTTPV_UPSTREAM_URL": "${HTTPV_UPSTREAM_URL:-http://host.docker.internal:9998}",
        "HTTPV_UPSTREAM_HOST": "${HTTPV_UPSTREAM_HOST:-127.0.0.1:9998}",
        "HTTPV_PROXY_CONNECT_TIMEOUT": "${HTTPV_PROXY_CONNECT_TIMEOUT:-5s}",
        "HTTPV_PROXY_READ_TIMEOUT": "${HTTPV_PROXY_READ_TIMEOUT:-60s}",
        "HTTPV_PROXY_SEND_TIMEOUT": "${HTTPV_PROXY_SEND_TIMEOUT:-60s}",
        "HTTPV_MAX_BODY_SIZE": "${HTTPV_MAX_BODY_SIZE:-64m}",
        "HTTPV_ACCESS_LOG": "${HTTPV_ACCESS_LOG:-off}"
      },
      "ports": ["${HTTPV_GATEWAY_BIND:-0.0.0.0}:${HTTPV_GATEWAY_PORT:-8088}:8088"],
      "extra_hosts": ["host.docker.internal:host-gateway"],
      "volumes": ["httpv_runtime:/run/httpv"],
      "depends_on": {
        "control": {"condition": "service_healthy"},
        "edge-agent": {"condition": "service_started"}
      },
      "healthcheck": {
        "test": ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8091/internal/metrics"],
        "interval": "10s",
        "timeout": "3s",
        "retries": 5
      },
      "security_opt": ["no-new-privileges:true"],
      "networks": ["internal"]
    },
    "web": {
      "image": "ghcr.io/yeshimin/httpv-web:${HTTPV_VERSION:-latest}",
      "restart": "unless-stopped",
      "ports": ["${HTTPV_CONSOLE_BIND:-127.0.0.1}:${HTTPV_CONSOLE_PORT:-5173}:80"],
      "depends_on": {"control": {"condition": "service_healthy"}},
      "healthcheck": {
        "test": ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1/healthz"],
        "interval": "10s",
        "timeout": "3s",
        "retries": 5
      },
      "security_opt": ["no-new-privileges:true"],
      "networks": ["internal"]
    }
  },
  "networks": {"internal": {"driver": "bridge"}},
  "volumes": {"httpv_runtime": {}}
}
